{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@buckminsterfullerene/codemirror-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Rstack Library Starter Template",
  "keywords": [
    "editor",
    "code"
  ],
  "homepage": "https://github.com/logue/fullerene-codemirror",
  "bugs": {
    "url": "https://github.com/logue/fullerene-codemirror/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/fullerene-codemirror.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "import": "./dist/index.umd.js",
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rs dev --open",
    "dev:docs": "pnpm run build:demo && rs doc",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "clean": "rimraf dist docs src-docs/public/demo",
    "clean:hard": "rimraf .rstack/cache .rstack/.rsdoctor demo dist docs node_modules/.tmp node_modules/.cache",
    "build": "rs lib",
    "build:demo": "rs build",
    "build:docs": "run-s build:demo build:rspress",
    "build:rspress": "rs doc build",
    "preview": "rs preview",
    "preview:docs": "rs doc preview",
    "analyze": "cross-env RSDOCTOR=true rs lib",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "skills:install": "npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m'",
    "skills:update": "npx skills update",
    "prepare": "rs hooks && pnpm run skills:install",
    "generate:palettes": "node scripts/generate-palettes.ts && rs fmt src/types/Palette.d.ts src/light-mode.ts src/dark-mode.ts"
  },
  "devDependencies": {
    "@carbon/styles": "^1.119.0",
    "@carbon/themes": "^11.85.0",
    "@carbon/web-components": "^2.67.0",
    "@codemirror/buildhelper": "^1.0.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsdoctor/agent-cli": "^0.1.2",
    "@rsdoctor/core": "^2.0.3",
    "@rspress/core": "^2.1.3",
    "@tsconfig/node-lts": "^26.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.4",
    "prettier-plugin-yaml": "^1.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "rstack": "^0.9.2",
    "taze": "^21.3.0",
    "typescript": "^7.0.2",
    "vue-codemirror6": "^1.8.0"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12.19"
  }
}
